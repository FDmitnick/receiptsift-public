# Start with sandbox. Change to live only after the full sandbox acceptance test.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLUS_PLAN_ID=
PAYPAL_PRO_PLAN_ID=
PAYPAL_WEBHOOK_ID=

# Draft beta defaults. Confirm these before creating the PayPal plan because its
# price cannot be silently changed after customers subscribe.
BILLING_FREE_MONTHLY_DOCUMENTS=5
BILLING_FREE_MONTHLY_PAGES=20
BILLING_FREE_MAX_PAGES_PER_DOCUMENT=5
BILLING_PLUS_MONTHLY_DOCUMENTS=100
BILLING_PLUS_MONTHLY_PAGES=200
BILLING_PLUS_MAX_PAGES_PER_DOCUMENT=15
BILLING_PLUS_MAX_FILES_PER_BATCH=25
BILLING_PLUS_PRICE_USD=9.00
BILLING_PRO_MONTHLY_DOCUMENTS=300
BILLING_PRO_MONTHLY_PAGES=500
BILLING_PRO_MAX_PAGES_PER_DOCUMENT=30
BILLING_PRO_MAX_FILES_PER_BATCH=100
BILLING_PRO_PRICE_USD=19.00
BILLING_CURRENCY=USD

# At least 32 random characters. Used to pseudonymize email/provider and network
# identifiers for rate limiting; raw identifiers are never stored in abuse tables.
ABUSE_HASH_SECRET=

# Used by scripts/setup_paypal.py when creating the webhook.
PAYPAL_WEBHOOK_URL=https://your-domain.example/api/billing/paypal/webhook
