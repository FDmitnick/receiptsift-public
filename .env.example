# Local storage location. Defaults to ./data
RECEIPTSIFT_DATA_DIR=./data

# Upload and document limits
RECEIPTSIFT_MAX_UPLOAD_MB=20
RECEIPTSIFT_MAX_PAGES=30
RECEIPTSIFT_MAX_PDF_XREF_OBJECTS=50000
RECEIPTSIFT_MAX_PDF_PAGE_DIMENSION=14400

# Hosted registration opens only when transactional email and the public site URL are configured.
RECEIPTSIFT_SESSION_SECRET=
RECEIPTSIFT_SESSION_DAYS=7
RECEIPTSIFT_SECURE_COOKIES=true

# Add these after custom domains are connected. Host-based routing sends app.*
# to the protected tool while the bare/www host serves the public SEO site.
RECEIPTSIFT_PUBLIC_HOST=
RECEIPTSIFT_APP_HOST=
# Enable only after Railway reports the app domain verified and HTTPS works.
RECEIPTSIFT_APP_HOST_REDIRECT_ENABLED=false
RECEIPTSIFT_SITE_URL=

# Transactional account email via Resend. Verify the sender domain before public registration.
RESEND_API_KEY=
RECEIPTSIFT_EMAIL_FROM=ReceiptSift <accounts@example.com>
RECEIPTSIFT_EMAIL_VERIFICATION_HOURS=24
RECEIPTSIFT_PASSWORD_RESET_MINUTES=30

# Single-owner operations console. Keep this to one verified ReceiptSift account.
RECEIPTSIFT_ADMIN_EMAIL=contact@example.invalid

# Closed owner-only mode. Existing non-owner sessions and all new registrations are rejected.
# Set OWNER_EMAIL to the verified account that may use the protected parser.
RECEIPTSIFT_OWNER_ONLY_MODE=true
RECEIPTSIFT_OWNER_EMAIL=contact@example.invalid
RECEIPTSIFT_OWNER_PLAN=free

# Consented first-party page/click events are purged after this many days.
RECEIPTSIFT_ANALYTICS_RETENTION_DAYS=180

# Required for encrypted recent history and the saved ledger; also protects optional diagnostic reports.
# Generate a dedicated key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If the key is blank or invalid, protected content storage fails closed and never falls back to plaintext.
RECEIPTSIFT_DIAGNOSTIC_ENCRYPTION_KEY=
RECEIPTSIFT_DIAGNOSTIC_RETENTION_DAYS=14
RECEIPTSIFT_HISTORY_RETENTION_DAYS=7

# Resumable batch workspace. Generate a separate Fernet key with the command above.
# Local development defaults to the main SQLite database and encrypted ./data/batch-objects.
# A single-replica, low-traffic deployment can keep SQLite on the mounted volume.
# Set PostgreSQL only after the capacity monitor shows repeated SQLite contention or before adding replicas.
RECEIPTSIFT_BATCH_ENCRYPTION_KEY=
RECEIPTSIFT_BATCH_DATABASE_URL=
RECEIPTSIFT_BATCH_SOURCE_RETENTION_DAYS=7
RECEIPTSIFT_BATCH_RESULT_RETENTION_DAYS=7
RECEIPTSIFT_BATCH_MAX_FILES=100
RECEIPTSIFT_BATCH_OBJECT_STORE=local
RECEIPTSIFT_BATCH_OBJECT_BUCKET=
RECEIPTSIFT_BATCH_OBJECT_ENDPOINT=
RECEIPTSIFT_BATCH_OBJECT_REGION=auto
RECEIPTSIFT_BATCH_OBJECT_ACCESS_KEY_ID=
RECEIPTSIFT_BATCH_OBJECT_SECRET_ACCESS_KEY=
RECEIPTSIFT_BATCH_OBJECT_PREFIX=receipt-sources
# embedded: one web replica starts a worker; separate: run python -m scripts.run_batch_worker; disabled: no processing.
RECEIPTSIFT_BATCH_WORKER_MODE=embedded
RECEIPTSIFT_BATCH_WORKER_POLL_SECONDS=1

# Optional Atlas Cloud vision pipeline. Keep "local" until an API key is configured.
RECEIPTSIFT_PARSER_PROVIDER=local
RECEIPTSIFT_ATLAS_API_KEY=
RECEIPTSIFT_ATLAS_BASE_URL=https://api.atlascloud.ai/v1
RECEIPTSIFT_ATLAS_PRIMARY_MODEL=qwen/qwen3.5-35b-a3b
RECEIPTSIFT_ATLAS_TEXT_MODEL=openai/gpt-5.6-luna
RECEIPTSIFT_ATLAS_FALLBACK_MODEL=qwen/qwen3-vl-235b-a22b-thinking
RECEIPTSIFT_ATLAS_TIMEOUT_SECONDS=90
RECEIPTSIFT_ATLAS_MIN_CONFIDENCE=0.85
RECEIPTSIFT_ATLAS_RENDER_SCALE=2.0
RECEIPTSIFT_ATLAS_MAX_RENDER_DIMENSION=3000
RECEIPTSIFT_GPT_VERIFIER_ENABLED=true
RECEIPTSIFT_GPT_VERIFIER_MODEL=openai/gpt-5.6-terra

# Zero-cost application safeguards. Aggregate counters are stored beside the
# existing SQLite file; no receipt content or new database schema is added.
RECEIPTSIFT_DAILY_AI_BUDGET_USD=5.00
RECEIPTSIFT_AI_CALL_RESERVE_USD=0.25
# Zero-cost capacity signals written to Railway JSON logs and /api/admin/runtime.
RECEIPTSIFT_SLOW_REQUEST_MS=2000
RECEIPTSIFT_SQLITE_CONTENTION_THRESHOLD=3
RECEIPTSIFT_BATCH_QUEUE_DELAY_WARNING_SECONDS=300
RECEIPTSIFT_ATLAS_PRIMARY_INPUT_USD_PER_MILLION=0.225
RECEIPTSIFT_ATLAS_PRIMARY_OUTPUT_USD_PER_MILLION=1.80
RECEIPTSIFT_ATLAS_TEXT_INPUT_USD_PER_MILLION=1.00
RECEIPTSIFT_ATLAS_TEXT_OUTPUT_USD_PER_MILLION=6.00
RECEIPTSIFT_ATLAS_FALLBACK_INPUT_USD_PER_MILLION=0.50
RECEIPTSIFT_ATLAS_FALLBACK_OUTPUT_USD_PER_MILLION=2.50
RECEIPTSIFT_GPT_VERIFIER_INPUT_USD_PER_MILLION=2.50
RECEIPTSIFT_GPT_VERIFIER_OUTPUT_USD_PER_MILLION=15.00

# In-process authentication limits. These are suitable only while Railway runs
# exactly one replica; they are not a replacement for a distributed limiter.
RECEIPTSIFT_AUTH_LOGIN_LIMIT=10
RECEIPTSIFT_AUTH_REGISTRATION_LIMIT=5
RECEIPTSIFT_AUTH_RECOVERY_LIMIT=5
RECEIPTSIFT_AUTH_LOGIN_WINDOW_SECONDS=900
RECEIPTSIFT_AUTH_RECOVERY_WINDOW_SECONDS=3600

# PayPal subscriptions. Keep PAYPAL_CLIENT_SECRET only in the hosting provider's secret store.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLUS_PLAN_ID=
PAYPAL_PRO_PLAN_ID=
PAYPAL_WEBHOOK_ID=
BILLING_FREE_MONTHLY_DOCUMENTS=5
BILLING_FREE_MONTHLY_PAGES=20
BILLING_FREE_MAX_PAGES_PER_DOCUMENT=5
BILLING_PLUS_MONTHLY_DOCUMENTS=100
BILLING_PLUS_MONTHLY_PAGES=200
BILLING_PLUS_MAX_PAGES_PER_DOCUMENT=15
BILLING_PLUS_MAX_FILES_PER_BATCH=25
BILLING_PLUS_PRICE_USD=9.00
BILLING_PRO_MONTHLY_DOCUMENTS=300
BILLING_PRO_MONTHLY_PAGES=500
BILLING_PRO_MAX_PAGES_PER_DOCUMENT=30
BILLING_PRO_MAX_FILES_PER_BATCH=100
BILLING_PRO_PRICE_USD=19.00
BILLING_CURRENCY=USD
